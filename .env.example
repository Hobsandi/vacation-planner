# Copy to .env.local and fill in. Never commit .env.local.
# Ask the teammate who owns each service for the values (send them privately, not in the repo).

# Supabase → Project settings → API (Person B)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq (free) → https://console.groq.com/keys (Person C). Without it, /api/plan returns mock data.
GROQ_API_KEY=
# Optional override, see https://console.groq.com/docs/models
GROQ_MODEL=

# Trafiklab ResRobot v2.1 (free) → https://developer.trafiklab.se → create a project → add "ResRobot v2.1".
# Used by lib/local for real public-transport routes to supported cities. Optional: skipped when empty.
RESROBOT_API_KEY=

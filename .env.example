# Copy to .env.local and fill in. Never commit .env.local.
# Ask the teammate who owns each service for the values (send them privately, not in the repo).

# Supabase → Project settings → API (Person B)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic Console → API keys (Person C). Without it, /api/plan returns mock data.
ANTHROPIC_API_KEY=
# Optional override, see https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=
